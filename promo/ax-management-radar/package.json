{
  "name": "ax-management-radar-promo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AxManagementRadarPromo out/render-bgm.mp4",
    "render:no-bgm": "remotion render src/index.ts AxManagementRadarPromo out/render-sfx-only.mp4 --props=props-nobgm.json",
    "still": "remotion still src/index.ts AxManagementRadarPromo",
    "typecheck": "tsc --noEmit",
    "audio:prepare": "node scripts/prepare_audio.mjs",
    "audio:check": "node scripts/prepare_audio.mjs --check"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "puppeteer": "^24.40.0",
    "typescript": "6.0.3"
  }
}
